rules_version = '2';

// Tek kural: herkes yalnızca kendi klasörüne girebilir.
// users/{uid} ve altındaki her şey (tasks, categories, series, dailyTracking,
// settings) sadece o uid ile giriş yapmış kullanıcıya açık. Başka hiçbir yol
// okunamaz ve yazılamaz.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /{document=**} {
        allow read, write: if isOwner(uid);
      }
    }
  }
}
