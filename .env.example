# Firebase web uygulaması anahtarları.
# Bu dosyayı `.env.local` adıyla kopyalayın ve değerleri Firebase konsolundan
# alın: Proje ayarları (⚙) → Genel → "Uygulamalarınız" → Web uygulaması →
# SDK kurulumu ve yapılandırması → Yapılandırma (firebaseConfig).
#
# Bu değerler tarayıcıya gönderilir, gizli değildir; veriyi koruyan şey
# firestore.rules'taki güvenlik kurallarıdır.
#
# Hepsi boşken uygulama "yerel mod"da açılır: veri yalnızca tarayıcıda durur.

NEXT_PUBLIC_FIREBASE_API_KEY=

# Yerelde firebaseConfig'teki değeri olduğu gibi bırakın
# (<proje>.firebaseapp.com). Yayındaki ortamda ise uygulamanın kendi alan
# adını yazın (ör. my-pusula.vercel.app): giriş akışı o zaman tek alan adında
# kalır ve WhatsApp gibi uygulama içi tarayıcılarda takılmaz. Bunu
# değiştirmeden önce her sağlayıcının yetkili yönlendirme adreslerine
# https://<alan-adi>/__/auth/handler eklenmelidir — bkz. README.
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=

NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Yerel Firebase emülatörlerine bağlanmak için 1 yapın (isteğe bağlı).
# NEXT_PUBLIC_FIREBASE_USE_EMULATOR=0
